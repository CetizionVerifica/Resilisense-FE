{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "PORT=3001 NODE_ENV=production DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "build": "react-scripts --max_old_space_size=4096 build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "sync": "aws s3 sync ./build 's3://myresilisense.org/'",
    "invalidate": "aws cloudfront create-invalidation --distribution-id EA05QUJY4ZW90 --paths '/*'",
    "deploy": "npm run build && npm run sync && npm run invalidate"
  },
  "proxy": {
    "/api/*": {
      "target": "http://ec2forresilisense.ddns.net/"
    },
    "/graphql/*": {
      "target": "http://ec2forresilisense.ddns.net/"
    },
    "/public/*": {
      "target": "http://ec2forresilisense.ddns.net/"
    }
  },
  "dependencies": {
    "@vtex/react-csv-parse": "^3.0.2",
    "antd": "^3.1.0",
    "apollo-client": "^2.6.10",
    "apollo-client-preset": "^1.0.6",
    "axios": "^0.17.1",
    "babel-eslint": "^8.0.3",
    "bugsnag-js": "^4.7.3",
    "bugsnag-react": "^1.1.1",
    "classnames": "^2.2.6",
    "concurrently": "^3.5.1",
    "dom-to-image": "^2.6.0",
    "dom-to-image-more": "^3.6.0",
    "echarts": "^4.0.4",
    "echarts-for-react": "^2.0.8",
    "eslint": "^4.13.1",
    "eslint-plugin-babel": "^4.1.2",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-jest": "^21.5.0",
    "eslint-plugin-react": "^7.5.1",
    "graphql": "^0.12.3",
    "graphql-tag": "^2.6.1",
    "html2canvas": "^1.0.0-alpha.12",
    "immutability-helper": "^3.1.1",
    "intl": "^1.2.5",
    "jspdf": "^1.5.3",
    "jspdf-autotable": "^3.2.4",
    "lodash": "^4.17.15",
    "materialize-css": "^0.100.2",
    "moment": "^2.20.1",
    "papaparse": "^4.5.0",
    "pdf-viewer-reactjs": "^2.0.5",
    "precise-ui": "^1.1.4",
    "prop-types": "^15.6.0",
    "query-string": "5.1.0",
    "react": "^16.14.0",
    "react-apollo": "^2.0.4",
