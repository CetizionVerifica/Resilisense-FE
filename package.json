    "react-intl-redux": "^0.7.0",
    "react-pdf": "^3.0.6",
    "react-redux": "^5.0.6",
    "react-router-dom": "^4.2.2",
    "react-scripts": "^1.0.17",
    "react-tooltip": "^4.2.7",
    "redux": "^3.7.2",
    "redux-form": "^7.2.0",
