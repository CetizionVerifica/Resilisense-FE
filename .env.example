# Copy to .env.local. Only VITE_* variables reach the browser bundle — never put secrets here.
# API origin for deployed builds (empty in development: Vite proxies /v1 to API_PROXY_TARGET).
VITE_API_BASE_URL=
# Where the dev server proxies /v1 (the CSR_BE API, `npm run dev` there).
API_PROXY_TARGET=http://localhost:4000
# 1 = serve the API from MSW mocks in the browser (no backend needed; used by Playwright).
VITE_API_MOCKS=0
